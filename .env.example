# Server
PORT=3011
NODE_ENV=production

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
JWT_SECRET=change-this-jwt-secret-in-production

# API Keys (comma-separated list of valid API keys for gateway access)
API_KEYS=cvg-api-key-change-me

# HMAC Key (base64 encoded, minimum 256-bit)
HMAC_KEY=Y2hhbmdlLXRoaXMtaG1hYy1rZXktaW4tcHJvZHVjdGlvbi1taW5pbXVtLTI1Ni1iaXQ=
HMAC_KEY_VERSION=v1

# Signing Key (base64 encoded RSA private key or HMAC secret for JWT signing)
SIGNING_KEY=Y2hhbmdlLXRoaXMtc2lnbmluZy1rZXktaW4tcHJvZHVjdGlvbg==
SIGNING_KEY_VERSION=v1

# NIU Connector
NIU_API_URL=https://api.egovwallet.com/api/kyc/verify
NIU_API_TIMEOUT=10000

# IVS Instance ID
IVS_INSTANCE_ID=IVS-MTN-01

# Trusted Gateway IDs (comma-separated)
TRUSTED_GATEWAYS=CVG-CTI-01
